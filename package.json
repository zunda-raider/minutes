{
  "name": "minutes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./scripts/polyfill-localstorage.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node -r ./scripts/polyfill-localstorage.cjs ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/polyfill-localstorage.cjs ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate-db.mjs"
  },
  "dependencies": {
    "next": "15.3.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
