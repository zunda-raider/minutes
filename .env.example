# Local whisper.cpp + ffmpeg paths (required for /api/transcribe)
# Copy to .env.local and adjust for your machine.

# Path to whisper-cli binary (whisper.cpp)
# Windows example: C:/Users/you/nminutes/whisper.cpp/build/bin/Release/whisper-cli.exe
# macOS example:   /Users/taiki714/Desktop/whisper/whisper.cpp/build/bin/whisper-cli
# Linux example:   /usr/local/bin/whisper-cli
WHISPER_BIN=

# Path to Whisper model file (use a multilingual model for ja+en switching)
# macOS quantized example (one model for both languages):
#   /Users/taiki714/Desktop/whisper/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin
# Other examples: ggml-base.bin (F16 multilingual), ggml-base-q5_0.bin, etc.
# English-only models (ggml-*.en.bin) cannot do Japanese well — avoid for ja/en toggle.
WHISPER_MODEL=

# ffmpeg binary (optional; defaults to "ffmpeg" on PATH)
# Windows example: D:/tools/ffmpeg/bin/ffmpeg.exe
FFMPEG_BIN=ffmpeg

# Temp directory for uploaded audio (optional; defaults to OS temp/minutes-temp)
TEMP_DIR=

# Default Whisper language when the client omits `lang` (optional; default: ja)
WHISPER_LANG=ja

# Allowed languages for the UI / API (comma-separated). Client sends one of these.
# Must be a multilingual model for non-English codes.
WHISPER_LANGS=ja,en

# --- Translation (/api/translate) ---
# Primary: local Ollama (default). Optional OpenAI fallback when TRANSLATE_PROVIDER=auto.
#
# macOS quick start:
#   brew install ollama
#   ollama serve
#   ollama pull llama3.2
#
TRANSLATE_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional OpenAI / compatible fallback (used if Ollama fails and provider=auto, or provider=openai)
OPENAI_API_KEY=
# TRANSLATE_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
