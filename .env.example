# Local whisper.cpp + ffmpeg paths (required for /api/transcribe)
# Copy to .env.local and adjust for your machine.

WHISPER_BIN=
WHISPER_MODEL=
# Faster model for GD live transcription only. Home / Note / Zoom stay on WHISPER_MODEL.
# GD defaults to this slot. If empty, GD falls back to WHISPER_MODEL.
# Example: /path/to/ggml-small-q8_0.bin
WHISPER_MODEL2=
FFMPEG_BIN=ffmpeg
TEMP_DIR=
WHISPER_LANG=ja
WHISPER_LANGS=ja,en

# --- Speaker diarization (話者分け) ---
# Prefer tinydiarize: download ggml-small.en-tdrz.bin and point WHISPER_MODEL at it (English-only).
# WHISPER_DIARIZE=1
# WHISPER_DIARIZE_MODE=tdrz
# Or embedding diarize (requires whisper-cli built with diarize support):
# WHISPER_DIARIZE_MODE=embedding
# WHISPER_SPEAKER_MODEL=/path/to/ggml-speaker-ecapa-tdnn.bin
# Or pass raw whisper-cli flags:
# WHISPER_DIARIZE_MODE=extra
# WHISPER_DIARIZE_ARGS=-tdrz

# --- Translation (/api/translate) — Ollama first ---
#
# macOS (user machine):
#   brew install ollama
#   ollama pull llama3.2          # default
#   ollama pull gemma2            # optional alternate
#   Models on this Mac: llama3.2:latest, gemma2:latest
#   Binary: /usr/local/bin/ollama
#
# When you run `npm run dev` or `next start` locally, /api/translate will
# probe http://127.0.0.1:11434 and, if down, try to spawn `ollama serve`
# in the background. This does NOT work on Vercel or in the browser alone.
#
TRANSLATE_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_MODEL=gemma2
OLLAMA_BIN=/usr/local/bin/ollama

# Optional OpenAI fallback (TRANSLATE_PROVIDER=auto or openai)
OPENAI_API_KEY=
# TRANSLATE_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- PostgreSQL (meeting notebooks / 議事録) ---
# Start: docker compose up -d db
# Migrate (first time or existing volume): npm run db:migrate
# Default matches docker-compose.yml:
DATABASE_URL=postgresql://minutes_user:minutes_pass@127.0.0.1:5432/minutes_db
